{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bobmst/einkk.app/main/contracts/history.schema.json",
  "title": "Forecast track record (draft 0.2.0)",
  "description": "Per season and server: our forecast and how it was graded, and/or the final 3% line. A final value comes from the maintainer's hand collection from community posts (JP's official-day lines included), our survey or our in-raid reports, never from another site's compiled data. The private engine writes it to the outbox.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issued_at",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2.0"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "entries": {
      "description": "Newest season first. Empty before anything is published.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "description": "Needs a forecast (which then brings its grading, and its band whenever one was published), a final value, or both.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "server"
      ],
      "anyOf": [
        {
          "required": [
            "forecast"
          ]
        },
        {
          "required": [
            "final"
          ]
        }
      ],
      "dependentRequired": {
        "forecast": [
          "grading"
        ]
      },
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 1
        },
        "server": {
          "enum": [
            "jp",
            "kr",
            "na",
            "sea",
            "tw",
            "gb"
          ]
        },
        "model_version": {
          "type": "string"
        },
        "forecast": {
          "description": "The forecast of record for the end-of-raid 3% line, in 0.1B.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "band": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lo",
            "hi",
            "level",
            "method"
          ],
          "properties": {
            "lo": {
              "type": "number"
            },
            "hi": {
              "type": "number"
            },
            "level": {
              "description": "The confidence level the method actually certifies. null for the legacy bands: JP's in-sample t-band and every server's posted range up to S41, labelled 99% or 99.9% but certifying no level.",
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 1
            },
            "method": {
              "enum": [
                "conformal_walk_forward",
                "t_in_sample_legacy"
              ]
            }
          },
          "if": {
            "properties": {
              "method": {
                "const": "conformal_walk_forward"
              }
            }
          },
          "then": {
            "properties": {
              "level": {
                "type": "number"
              }
            }
          }
        },
        "grading": {
          "description": "null until the season is graded.",
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "error_pct",
                "hit"
              ],
              "properties": {
                "error_pct": {
                  "description": "Signed: (forecast - final) / final x 100.",
                  "type": "number"
                },
                "hit": {
                  "description": "Whether the final border fell inside the band; null when no band was published.",
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "final": {
          "description": "The final 3% line, in 0.1B.",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "source"
          ],
          "properties": {
            "value": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "source": {
              "description": "manual_collection: collected by hand by the maintainer from community posts. survey: our end-of-season survey. reports: in-raid reports to this site.",
              "enum": [
                "manual_collection",
                "survey",
                "reports"
              ]
            },
            "n": {
              "description": "How many observations the value rests on. Required for survey and reports, where it is often small.",
              "type": "integer",
              "minimum": 1
            }
          },
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "survey",
                  "reports"
                ]
              }
            }
          },
          "then": {
            "required": [
              "n"
            ]
          }
        }
      },
      "allOf": [
        {
          "description": "A hit/miss needs a band to judge it by. A forecast posted without a range (S15-S20) carries no band and grades with hit: null.",
          "if": {
            "required": [
              "grading"
            ],
            "properties": {
              "grading": {
                "type": "object",
                "required": [
                  "hit"
                ],
                "properties": {
                  "hit": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          "then": {
            "required": [
              "band"
            ]
          }
        }
      ]
    }
  }
}
