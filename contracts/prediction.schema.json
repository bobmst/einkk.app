{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bobmst/einkk.app/main/contracts/prediction.schema.json",
  "title": "Solo Raid border prediction (draft 0.1.0)",
  "description": "One published update of the predicted end-of-raid border for one server. The private engine writes it to the outbox and this site reads it. Values are in 0.1B (1e8 damage). Owned by this repository; the engine pins a tagged version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "issued_at",
    "season",
    "server",
    "model_version",
    "state",
    "target",
    "prediction",
    "band",
    "provisional",
    "inputs",
    "dq"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "season": {
      "type": "integer",
      "minimum": 1
    },
    "server": {
      "enum": [
        "jp",
        "kr",
        "na",
        "sea",
        "tw",
        "gb"
      ]
    },
    "model_version": {
      "type": "string"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raid_day",
        "day_fraction",
        "hours_to_close",
        "known_days",
        "method"
      ],
      "properties": {
        "raid_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "day_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hours_to_close": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "known_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "method": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percentile",
        "unit",
        "horizon"
      ],
      "properties": {
        "percentile": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "unit": {
          "const": "0.1B"
        },
        "horizon": {
          "const": "raid_close"
        }
      }
    },
    "prediction": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "band": {
      "description": "The band and the level it actually certifies travel together, so a band can never be rendered at a level it was not built for.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo",
        "hi",
        "level",
        "method"
      ],
      "properties": {
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "method": {
          "enum": [
            "conformal_walk_forward"
          ]
        }
      }
    },
    "cells": {
      "description": "Optional per-percentile values on the same server, e.g. 0.5/1/2/3/5%.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "percentile",
          "value"
        ],
        "properties": {
          "percentile": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "value": {
            "type": "number"
          },
          "lo": {
            "type": "number"
          },
          "hi": {
            "type": "number"
          },
          "extrapolated": {
            "type": "boolean"
          }
        }
      }
    },
    "provisional": {
      "description": "true while the latest finished day's official border is not confirmed yet and an estimate from reports stands in for it.",
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchors",
        "reports_used_today",
        "nowcast"
      ],
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "value",
              "source"
            ],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "value": {
                "type": "number"
              },
              "source": {
                "enum": [
                  "official",
                  "reports_estimate"
                ]
              }
            }
          }
        },
        "reports_used_today": {
          "type": "integer",
          "minimum": 0
        },
        "nowcast": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "dq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reports_seen_today",
        "reports_rejected_today",
        "blocking",
        "notes"
      ],
      "properties": {
        "reports_seen_today": {
          "type": "integer",
          "minimum": 0
        },
        "reports_rejected_today": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
