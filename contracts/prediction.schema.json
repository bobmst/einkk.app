{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/bobmst/einkk.app/main/contracts/prediction.schema.json",
  "title": "Solo Raid border prediction (draft 0.7.0)",
  "description": "One published update of the predicted end-of-raid border for one server. The private engine writes it to the outbox and this site reads it. Values are in 0.1B (1e8 damage). Owned by this repository; the engine pins a tagged version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "revision",
    "issued_at",
    "season",
    "server",
    "model_version",
    "state",
    "target",
    "prediction",
    "band",
    "provisional",
    "inputs",
    "dq"
  ],
  "properties": {
    "schema_version": {
      "const": "0.7.0"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "season": {
      "type": "integer",
      "minimum": 1
    },
    "server": {
      "enum": [
        "jp",
        "kr",
        "na",
        "sea",
        "tw",
        "gb"
      ]
    },
    "model_version": {
      "type": "string"
    },
    "code_sha": {
      "description": "The engine commit this forecast was made with (git SHA, 7 to 40 lowercase hex), so a season review can tie each revision to its code. Absent when the engine ran outside a git checkout.",
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raid_day",
        "day_fraction",
        "hours_to_close",
        "known_days",
        "method"
      ],
      "properties": {
        "raid_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        "day_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "hours_to_close": {
          "type": "number",
          "minimum": 0,
          "maximum": 120
        },
        "known_days": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "method": {
          "type": "string"
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "percentile",
        "unit",
        "horizon"
      ],
      "properties": {
        "percentile": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "unit": {
          "const": "0.1B"
        },
        "horizon": {
          "const": "raid_close"
        }
      }
    },
    "prediction": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "band": {
      "description": "The band and the level it actually certifies travel together, so a band can never be rendered at a level it was not built for.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lo",
        "hi",
        "level",
        "method"
      ],
      "properties": {
        "lo": {
          "type": "number"
        },
        "hi": {
          "type": "number"
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "method": {
          "enum": [
            "conformal_walk_forward"
          ]
        }
      }
    },
    "cells": {
      "description": "Optional per-percentile values on the same server, e.g. 0.5/1/2/3/5%.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "percentile",
          "value"
        ],
        "properties": {
          "percentile": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          },
          "value": {
            "type": "number"
          },
          "lo": {
            "type": "number"
          },
          "hi": {
            "type": "number"
          },
          "extrapolated": {
            "type": "boolean"
          }
        }
      }
    },
    "bands": {
      "description": "The same walk-forward band at several levels, narrowest first, each labelled with the level it actually certifies (a level the sample can't reach is capped). band is the widest of these. The page shades them nested; a cell's range at any level is its value scaled by that band's lo/prediction and hi/prediction.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "lo",
          "hi"
        ],
        "properties": {
          "level": {
            "type": "number",
            "exclusiveMinimum": 0,
            "exclusiveMaximum": 1
          },
          "lo": {
            "type": "number"
          },
          "hi": {
            "type": "number"
          }
        }
      }
    },
    "provisional": {
      "description": "true while the latest finished day's official border is not confirmed yet and an estimate from reports stands in for it.",
      "type": "boolean"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "anchors",
        "reports_used_today",
        "nowcast"
      ],
      "properties": {
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "day",
              "value",
              "source"
            ],
            "properties": {
              "day": {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              "value": {
                "type": "number"
              },
              "source": {
                "enum": [
                  "official",
                  "reports_estimate"
                ]
              }
            }
          }
        },
        "reports_used_today": {
          "type": "integer",
          "minimum": 0
        },
        "nowcast": {
          "type": [
            "number",
            "null"
          ]
        }
      }
    },
    "dq": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reports_seen_today",
        "reports_rejected_today",
        "blocking",
        "notes"
      ],
      "properties": {
        "reports_seen_today": {
          "type": "integer",
          "minimum": 0
        },
        "reports_rejected_today": {
          "type": "integer",
          "minimum": 0
        },
        "blocking": {
          "type": "boolean"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "residuals": {
      "description": "The walk-forward checks the bands come from: for each recent finished season, how far this route (or this server line) missed, signed (forecast - final) / final x 100. Few of them means the bands rest on little; the page can plot them as dots.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "season",
          "error_pct"
        ],
        "properties": {
          "season": {
            "type": "integer",
            "minimum": 1
          },
          "error_pct": {
            "type": "number"
          }
        }
      }
    },
    "shadow_nowcast": {
      "description": "Reference only, never used by this forecast: on the morning of raid day 3 (n2 is in, n3 isn't), this server's final 3% line as it would be if today's player reports on every server stood in for n3. Present only when at least one report was used. On day 2 a known n2 doesn't improve the final in walk-forward tests, so nothing is shown then. Replaces 0.4.0's day-line fields, which only the uat rehearsal published.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "day",
        "final",
        "reports_used",
        "servers"
      ],
      "properties": {
        "day": {
          "description": "The raid day whose reports were used (3).",
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "final": {
          "description": "This server's final 3% line with the reports, 0.1B.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reports_used": {
          "type": "integer",
          "minimum": 1
        },
        "servers": {
          "description": "Reports used per server.",
          "type": "object",
          "propertyNames": {
            "enum": [
              "jp",
              "kr",
              "na",
              "sea",
              "tw",
              "gb"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "rank_slide": {
      "description": "Where an in-game rank read when this forecast was issued is likely to be at the close, if the score stays: per start rank (rank_pc, %), the median final rank and the range (lo, hi) at `level`. Worked out by the engine from how ranks slid in past seasons; the page only interpolates between rows. Absent outside raid days 2-5 or without enough past data (0.7.0).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hours_to_close",
        "level",
        "rows"
      ],
      "properties": {
        "hours_to_close": {
          "type": "number",
          "minimum": 0
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "rank_pc",
              "median",
              "lo",
              "hi"
            ],
            "properties": {
              "rank_pc": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "median": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "lo": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "hi": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        }
      }
    }
  }
}
