# Security headers for every static page (Workers static assets, see wrangler.jsonc).
# Next's static export bootstraps with inline scripts and Emotion injects inline
# styles, hence 'unsafe-inline'; Turnstile loads from challenges.cloudflare.com.
# Cloudflare Web Analytics (#119) injects its cookieless beacon into every page: it
# loads from static.cloudflareinsights.com and reports to cloudflareinsights.com (or,
# when injected automatically, to this site's own /cdn-cgi/rum, which 'self' covers).
# Both hosts are the ones Cloudflare's own CSP table lists for Web Analytics.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com https://cloudflareinsights.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
