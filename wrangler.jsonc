// Cloudflare Worker for einkk.app (docs/ARCHITECTURE.md, "Hosting").
// For now it only serves the static export in out/. The intake/read API will
// add "main", a "run_worker_first" pattern for /api/*, and the D1 / R2 bindings.
// The name must match the Worker (project) name in the Cloudflare dashboard.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "einkk-app",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
